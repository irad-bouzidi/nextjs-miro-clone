# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/miro_clone?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signs short-lived collaboration WebSocket tickets.
# Optional: falls back to CLERK_SECRET_KEY. Generate with: openssl rand -base64 32
COLLAB_SECRET=
